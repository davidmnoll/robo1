# Rosmaster A1 Robot Configuration
# Copy this file to .env and customize for your robot

# Robot ID - used for ROS2 topic namespacing
# If not set, uses sanitized hostname
ROBOT_ID=rosmaster1

# ROS2 Domain ID - must match other nodes in your network
# Default is 0, but using a unique ID prevents interference
ROS_DOMAIN_ID=62

# Serial port for Rosmaster board
# Usually /dev/ttyUSB0 or /dev/myserial (if udev rule configured)
SERIAL_PORT=/dev/myserial

# Camera device
CAMERA_DEVICE=/dev/video0

# Camera resolution
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
