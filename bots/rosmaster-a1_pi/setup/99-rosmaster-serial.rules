# Rosmaster A1 USB Serial Device Rules
# Uses USB port path for stable symlinks regardless of enumeration order
#
# To install: sudo cp 99-rosmaster-serial.rules /etc/udev/rules.d/
# To reload:  sudo udevadm control --reload-rules && sudo udevadm trigger
#
# USB Port Layout (Pi 5):
#   1-1.1   -> YDLIDAR (CP2102)
#   1-1.2   -> Motor Controller (CH340)
#   1-1.3.3 -> Speech Module (CH340)

# YDLIDAR - CP2102 on port 1-1.1
KERNEL=="ttyUSB*", KERNELS=="1-1.1", MODE:="0777", SYMLINK+="rplidar"

# Motor Controller - CH340 on port 1-1.2
KERNEL=="ttyUSB*", KERNELS=="1-1.2", MODE:="0777", SYMLINK+="myserial"

# Speech Module - CH340 on port 1-1.3.3
KERNEL=="ttyUSB*", KERNELS=="1-1.3.3", MODE:="0777", SYMLINK+="myspeech"
